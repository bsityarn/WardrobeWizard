<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProfileActivity"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/textViewProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Profile"
        android:textSize="36sp"
        android:gravity="center"
        android:fontFamily="@font/garamond"
        android:layout_margin="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/ivProfilePic"
        android:layout_width="300sp"
        android:layout_height="300sp"
        android:layout_marginStart="52dp"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewProfile"
        android:src="@android:drawable/ic_menu_gallery"
        >

    </ImageView>

    <LinearLayout
        android:id="@+id/llProfileInfo1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivProfilePic"
        android:layout_margin="10dp">

        <EditText
            android:id="@+id/editTextFirstName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:hint="First name"
            android:inputType="textPersonName|textCapWords"
            android:minHeight="48dp"
            android:fontFamily="@font/didact_gothic" />

        <EditText
            android:id="@+id/editTextLastName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Last name"
            android:inputType="textPersonName|textCapWords"
            android:minHeight="48dp"
            android:fontFamily="@font/didact_gothic" />

    </LinearLayout>


    <!-- Birthday and Gender -->
    <LinearLayout
        android:id="@+id/llProfileInfo2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llProfileInfo1"
        android:layout_margin="10dp">

        <!-- Birthday: 70% -->
        <EditText
            android:id="@+id/editTextBirthday"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="7"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/didact_gothic"
            android:hint="Birthday"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:inputType="none"
            android:minHeight="48dp"
            />

        <!-- Gender: 30% -->
        <Spinner
            android:id="@+id/spinnerGender"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:minHeight="48dp"
            android:fontFamily="@font/didact_gothic"
            />

    </LinearLayout>


    <LinearLayout
        android:id="@+id/llButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llProfileInfo2"
        android:layout_marginTop="20dp"
        android:layout_margin="10dp">

        <Button
            android:id="@+id/buttonChangePassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#d7e8f4"
            android:fontFamily="@font/didact_gothic"
            android:text="Change Password"
            android:textColor="#000000"
            android:layout_margin="20dp"/>

        <Button
            android:id="@+id/buttonSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#d7e8f4"
            android:fontFamily="@font/didact_gothic"
            android:text="Save"
            android:textColor="#000000"
            android:layout_margin="20dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>