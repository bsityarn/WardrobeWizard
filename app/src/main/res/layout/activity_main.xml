<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Dashboard Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Logo -->
            <ImageView
                android:layout_width="78dp"
                android:layout_height="65dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Wardrobe Wizard logo"
                android:scaleType="centerInside"
                android:src="@drawable/logo" />

            <!-- Greeting -->
            <TextView
                android:id="@+id/textViewGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="Hi Marc"
                android:textColor="#000000"
                android:textSize="48sp"
                android:fontFamily="@font/cormorant_garamond_light" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/textViewSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="15dp"
                android:gravity="center"
                android:text="What are we wearing today?"
                android:textColor="#000000"
                android:textSize="24sp"
                android:fontFamily="@font/cormorant_garamond_light" />

            <!-- Recent Outfits Heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="16dp"
                android:text="Recent Outfits"
                android:textColor="#111111"
                android:textSize="22sp"
                android:fontFamily="@font/didact_gothic" />

            <!-- Recent Outfits -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imageOutfit1"
                        android:layout_width="150dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="20dp"
                        android:background="@drawable/dashboard_image_border"
                        android:padding="3dp"
                        android:scaleType="centerCrop"
                        android:src="@android:drawable/ic_menu_gallery"
                        android:contentDescription="Recent outfit 1" />

                    <ImageView
                        android:id="@+id/imageOutfit2"
                        android:layout_width="150dp"
                        android:layout_height="180dp"
                        android:layout_marginEnd="20dp"
                        android:background="@drawable/dashboard_image_border"
                        android:padding="3dp"
                        android:scaleType="centerCrop"
                        android:src="@android:drawable/ic_menu_gallery"
                        android:contentDescription="Recent outfit 2" />

                    <ImageView
                        android:id="@+id/imageOutfit3"
                        android:layout_width="150dp"
                        android:layout_height="180dp"
                        android:background="@drawable/dashboard_image_border"
                        android:padding="3dp"
                        android:scaleType="centerCrop"
                        android:src="@android:drawable/ic_menu_gallery"
                        android:contentDescription="Recent outfit 3" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Recent Items Heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:text="Recent Items"
                android:textColor="#111111"
                android:textSize="22sp"
                android:fontFamily="@font/didact_gothic" />

            <!-- Recent Items -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="155dp"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imageItem1"
                        android:layout_width="150dp"
                        android:layout_height="145dp"
                        android:layout_marginEnd="20dp"
                        android:background="@drawable/dashboard_image_border"
                        android:padding="3dp"
                        android:scaleType="centerInside"
                        android:src="@android:drawable/ic_menu_gallery"
                        android:contentDescription="Recent item 1" />

                    <ImageView
                        android:id="@+id/imageItem2"
                        android:layout_width="150dp"
                        android:layout_height="145dp"
                        android:layout_marginEnd="20dp"
                        android:background="@drawable/dashboard_image_border"
                        android:padding="3dp"
                        android:scaleType="centerInside"
                        android:src="@android:drawable/ic_menu_gallery"
                        android:contentDescription="Recent item 2" />

                    <ImageView
                        android:id="@+id/imageItem3"
                        android:layout_width="150dp"
                        android:layout_height="145dp"
                        android:background="@drawable/dashboard_image_border"
                        android:padding="3dp"
                        android:scaleType="centerInside"
                        android:src="@android:drawable/ic_menu_gallery"
                        android:contentDescription="Recent item 3" />

                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#D7E8F4"
        android:elevation="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- Home -->

        <!-- Home -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/home"
                android:scaleType="fitCenter"
                android:contentDescription="Home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HOME"
                android:textSize="11sp"
                android:textColor="#000000"
                android:fontFamily="@font/didact_gothic" />

        </LinearLayout>


        <!-- Wardrobe -->
        <LinearLayout
            android:id="@+id/navWardrobe"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/wardrobe"
                android:scaleType="fitCenter"
                android:contentDescription="Wardrobe" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WARDROBE"
                android:textSize="11sp"
                android:textColor="#000000"
                android:fontFamily="@font/didact_gothic" />

        </LinearLayout>

        <!-- Add -->
        <LinearLayout
            android:id="@+id/navAdd"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="-24dp"
                android:background="@drawable/dashboard_add_button"
                android:gravity="center"
                android:text="+"
                android:textSize="38sp"
                android:textColor="#000000"
                android:elevation="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:text="ADD"
                android:textSize="11sp"
                android:textColor="#000000"
                android:fontFamily="@font/didact_gothic" />
        </LinearLayout>

        <!-- Outfits -->
        <LinearLayout
            android:id="@+id/navOutfits"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/outfits"
                android:scaleType="fitCenter"
                android:contentDescription="Outfits" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OUTFITS"
                android:textSize="11sp"
                android:textColor="#000000"
                android:fontFamily="@font/didact_gothic" />

        </LinearLayout>

        <!-- Profile -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/profile"
                android:scaleType="fitCenter"
                android:contentDescription="Profile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROFILE"
                android:textSize="11sp"
                android:textColor="#000000"
                android:fontFamily="@font/didact_gothic" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
